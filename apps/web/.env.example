# Copy to .env (local) or set in Vercel project settings.
# MongoDB connection string for the GridLeads dashboard.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/gridleads?retryWrites=true&w=majority

# Dashboard login (one account) and the key that signs the session cookie.
# AUTH_SECRET is required: without it nobody can log in. Generate with: openssl rand -hex 32
EMAIL=
PASSWORD=
AUTH_SECRET=

# Vapi (vapi.ai) outbound calling — Groups tab 📞 Call
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Outreach: the master key that seals the sender accounts' app passwords in the
# database (lib/secretBox.mjs). 32 bytes, base64. Generate with: openssl rand -base64 32
# Without it no password can be stored or used. If it is lost or changed, every
# stored password has to be typed in again.
OUTREACH_SECRET_KEY=

# Outreach without an open browser tab: a scheduler (cron-job.org) calls
# POST /api/outreach/cron with "Authorization: Bearer <this value>". At least 32
# characters. Generate with: openssl rand -hex 32
# Empty = the cron route is closed and the runner tab is the only way to send.
CRON_SECRET=

# Melodia: the "↗ Melodia" button of the leads table sends the ticked businesses
# to its company intake (POST https://melodia-kt.vercel.app/api/bot/companies,
# header x-api-key). The key Melodia gives you as COMPANY_API_KEY.
# Empty = the button answers that the key is missing.
MELODIA_API_KEY=
